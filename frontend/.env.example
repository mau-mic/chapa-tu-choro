# Keep empty: use the same-origin /api proxy in Vite, nginx or CloudFront.
# A separate API origin also requires an explicit backend Cors:AllowedOrigins entry.
# This is public build-time configuration, never an API key or secret.
VITE_API_BASE_URL=

# Public HTTPS origin for canonical URLs and sitemap. Empty builds are noindex.
VITE_SITE_URL=
# Set true for previews even when testing a real canonical origin.
VITE_SEO_NOINDEX=false
# Optional build-process variable (not exposed to browser): path relative to frontend/.
# SEO_STATISTICS_FILE=.generated/statistics.json
