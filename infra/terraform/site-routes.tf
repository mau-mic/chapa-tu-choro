# Generated by the same Vite build as the static pages. Never rewrite unknown URLs to 200.
resource "aws_cloudfront_function" "site_routes" {
  name    = "${local.prefix}-site-routes"
  runtime = "cloudfront-js-2.0"
  comment = "Published HTML routes and canonical redirects"
  publish = true
  # Validation can run before a build; planning a deployment requires the real artifact.
  code = fileexists(var.frontend_router_path) ? file(var.frontend_router_path) : "function handler(event) { return event.request; }"
  lifecycle {
    precondition {
      condition     = fileexists(var.frontend_router_path)
      error_message = "Build frontend first: the generated cloudfront-router.js must match the published HTML."
    }
  }
}

variable "frontend_router_path" {
  type        = string
  description = "Generated CloudFront routing function from the frontend build being published."
  default     = "../../frontend/dist/cloudfront-router.js"
}
