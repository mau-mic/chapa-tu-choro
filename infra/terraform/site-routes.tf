locals {
  generated_router = fileexists(var.frontend_router_path) ? file(var.frontend_router_path) : "function handler(event) { return event.request; }"
  site_router_code = <<-JS
${replace(local.generated_router, "function handler(event)", "function routeRequest(event)")}
function handler(event) {
  var request = event.request;
  var domain = ${jsonencode(var.site_domain)};
  var host = request.headers && request.headers.host;
  if (domain && host && host.value.toLowerCase() === 'www.' + domain) {
    var pairs = [];
    var query = request.querystring || {};
    Object.keys(query).forEach(function(key) {
      var values = query[key].multiValue || [query[key]];
      values.forEach(function(item) { pairs.push(encodeURIComponent(key) + '=' + encodeURIComponent(item.value)); });
    });
    return {statusCode: 308, headers: {location: {value: 'https://' + domain + request.uri + (pairs.length ? '?' + pairs.join('&') : '')}}};
  }
  if (request.uri.indexOf('/api/') === 0) return request;
  return routeRequest(event);
}
JS
}

# Generated by the same Vite build as the static pages. Never rewrite unknown URLs to 200.
resource "aws_cloudfront_function" "site_routes" {
  name    = "${local.prefix}-site-routes"
  runtime = "cloudfront-js-2.0"
  comment = "Published HTML routes and canonical redirects"
  publish = true
  # Validation can run before a build; planning a deployment requires the real artifact.
  code = local.site_router_code
  lifecycle {
    precondition {
      condition     = length(base64encode(local.site_router_code)) <= 13332 && can(regex("function handler\\(event\\)", local.generated_router))
      error_message = "The edge router must expose handler(event) and fit CloudFront's 10 KB limit including the domain redirect."
    }
    precondition {
      condition     = fileexists(var.frontend_router_path)
      error_message = "Build frontend first: the generated cloudfront-router.js must match the published HTML."
    }
  }
}

variable "frontend_router_path" {
  type        = string
  description = "Generated CloudFront routing function from the frontend build being published."
  default     = "../../frontend/dist/cloudfront-router.js"
}
